    ],
    "additionalProperties": false,
    "required": [
     "week",
     "live"
    ],
    "description": "Google's \"Popular times\": for each day, how busy each hour usually is, 0 (empty) to 100 (busiest); and how busy it is now when Google says so (`live`, its label in `language`). null when Google shows none.",
    "properties": {
     "week": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "day",
        "hours"
       ],

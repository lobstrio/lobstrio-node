        "day": {
         "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
         ]
        },
        "hours": {
         "type": "array",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "hour",
           "busyness"
          ],
          "properties": {
           "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
           },
           "busyness": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
           }
          }
         }
        }
       }
      }
     },
     "live": {
      "type": [
       "object",
